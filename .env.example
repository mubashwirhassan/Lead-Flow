# Copy to .env and fill in. NEVER commit real secrets.
APP_NAME="AI LeadFlow CRM"
APP_URL="http://localhost:3000"
NODE_ENV="development"

# MongoDB (NoSQL). Each client deployment points DATABASE_URL at its own database.
DATABASE_URL="mongodb://localhost:27017/leadflow_crm"

# Session signing secret: generate with `openssl rand -hex 32`
AUTH_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_STRING"

# OpenAI-compatible AI provider (base URL, key and model come from env)
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4o-mini"

# Email provider (Resend). If empty, invite/reset links are logged to the server console.
EMAIL_API_KEY=""
EMAIL_FROM="AI LeadFlow CRM <noreply@example.com>"

# One-time admin seed (npm run seed)
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-now"
